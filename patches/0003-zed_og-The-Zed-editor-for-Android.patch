+//! The menu bar, drawn by the app: Android has no platform menu bar.
+//!
+//! The bar is adapted from Zed's crates/title_bar/src/application_menu.rs (v0.233.10), Copyright 2022 - 2025 Zed
+//! Industries, Inc., licensed GPL-3.0-or-later like this crate. Kept: one button and popover per menu, F10, and
+//! left/right between open menus. Changed: no title-bar settings or title bar; a narrow window shows one menu button
+//! with every menu in it; the menus are this build's (`og_menus`).
+
+use gpui::{Action, Entity, Menu, MenuItem, OwnedMenu, OwnedMenuItem, Pixels, actions, px};
+use schemars::JsonSchema;
+use serde::Deserialize;
+use ui::{ContextMenu, PopoverMenu, PopoverMenuHandle, Tooltip, prelude::*};
+
+use crate::filter;
+
+actions!(
+    app_menu,
+    [
+        /// Opens the menu to the right of the open one.
+        ActivateMenuRight,
+        /// Opens the menu to the left of the open one.
+        ActivateMenuLeft
+    ]
+);
+
+/// Opens the named menu; a name this build has no menu for opens the first one (the stock keymap's F10 names "Zed").
+#[derive(Clone, Deserialize, JsonSchema, PartialEq, Default, Action)]
+#[action(namespace = app_menu)]
+pub struct OpenApplicationMenu(String);
+
+/// Below this width the bar is one menu button.
+const NARROW: Pixels = px(600.);
+
+/// File, Edit, Selection, View and Go: what this build can do, nothing that needs a second window, a folder picker,
+/// a language server or a left-out feature. Anything [`filter::in_menu`] refuses is dropped (code logged).
+pub(crate) fn og_menus() -> Vec<Menu> {
+    let menus = vec![
+        Menu::new("File").items([
+            MenuItem::action("New File", workspace::NewFile),
+            MenuItem::separator(),
+            MenuItem::action("Save", workspace::Save { save_intent: None }),
+            MenuItem::action("Save All", workspace::SaveAll { save_intent: None }),
+            MenuItem::separator(),
+            MenuItem::action(
+                "Close Editor",
+                workspace::CloseActiveItem {
+                    save_intent: None,
+                    close_pinned: true,
+                },
+            ),
+            MenuItem::action("Close Window", workspace::CloseWindow),
+        ]),
+        Menu::new("Edit").items([
+            MenuItem::action("Undo", editor::actions::Undo),
+            MenuItem::action("Redo", editor::actions::Redo),
+            MenuItem::separator(),
+            MenuItem::action("Cut", editor::actions::Cut),
+            MenuItem::action("Copy", editor::actions::Copy),
+            MenuItem::action("Paste", editor::actions::Paste),
+            MenuItem::separator(),
+            MenuItem::action("Find", search::buffer_search::Deploy::find()),
+            MenuItem::action("Find in Project", workspace::DeploySearch::default()),
+            MenuItem::separator(),
+            MenuItem::action(
+                "Toggle Line Comment",
+                editor::actions::ToggleComments::default(),
+            ),
+        ]),
+        Menu::new("Selection").items([
+            MenuItem::action("Select All", editor::actions::SelectAll),
+            MenuItem::action("Expand Selection", editor::actions::SelectLargerSyntaxNode),
+            MenuItem::action("Shrink Selection", editor::actions::SelectSmallerSyntaxNode),
+            MenuItem::separator(),
+            MenuItem::action(
+                "Add Cursor Above",
+                editor::actions::AddSelectionAbove {
+                    skip_soft_wrap: true,
+                },
+            ),
+            MenuItem::action(
+                "Add Cursor Below",
+                editor::actions::AddSelectionBelow {
+                    skip_soft_wrap: true,
+                },
+            ),
+            MenuItem::action(
+                "Select Next Occurrence",
+                editor::actions::SelectNext {
+                    replace_newest: false,
+                },
+            ),
+            MenuItem::action("Select All Occurrences", editor::actions::SelectAllMatches),
+            MenuItem::separator(),
+            MenuItem::action("Move Line Up", editor::actions::MoveLineUp),
+            MenuItem::action("Move Line Down", editor::actions::MoveLineDown),
+            MenuItem::action("Duplicate Selection", editor::actions::DuplicateLineDown),
+        ]),
+        Menu::new("View").items([
+            MenuItem::action("Command Palette", zed_actions::command_palette::Toggle),
+            MenuItem::action("Project Panel", zed_actions::project_panel::ToggleFocus),
+            MenuItem::separator(),
+            MenuItem::action(
+                "Zoom In",
+                zed_actions::IncreaseBufferFontSize { persist: false },
+            ),
+            MenuItem::action(
+                "Zoom Out",
+                zed_actions::DecreaseBufferFontSize { persist: false },
+            ),
+            MenuItem::action(
+                "Reset Zoom",
+                zed_actions::ResetBufferFontSize { persist: false },
+            ),
+        ]),
+        Menu::new("Go").items([
+            MenuItem::action("Back", workspace::GoBack),
+            MenuItem::action("Forward", workspace::GoForward),
+            MenuItem::separator(),
+            MenuItem::action("Go to File…", workspace::ToggleFileFinder::default()),
+            MenuItem::action(
+                "Go to Symbol in Editor…",
+                zed_actions::outline::ToggleOutline,
+            ),
+            MenuItem::action("Go to Line/Column…", editor::actions::ToggleGoToLine),
+        ]),
+    ];
+    menus
+        .into_iter()
+        .map(|menu| Menu {
+            items: menu
+                .items
+                .into_iter()
+                .filter(|item| match item {
+                    MenuItem::Action { action, .. } => {
+                        let shown = filter::in_menu(action.name());
+                        if !shown {
+                            log::error!("zed_og: E_MENU_HIDDEN");
+                        }
+                        shown
+                    }
+                    _ => true,
+                })
+                .collect(),
+            ..menu
+        })
+        .collect()
+}
+
+#[derive(Clone)]
+struct MenuEntry {
+    menu: OwnedMenu,
+    handle: PopoverMenuHandle<ContextMenu>,
+}
+
+pub(crate) struct AppMenuBar {
+    entries: Vec<MenuEntry>,
+    /// The narrow window's single button.
+    all: PopoverMenuHandle<ContextMenu>,
+    pending_menu_open: Option<String>,
+}
+
+impl AppMenuBar {
+    pub(crate) fn new(cx: &mut Context<Self>) -> Self {
+        let entries = cx
+            .get_menus()
+            .unwrap_or_default()
+            .into_iter()
+            .map(|menu| MenuEntry {
+                menu,
+                handle: PopoverMenuHandle::default(),
+            })
+            .collect();
+        Self {
+            entries,
+            all: PopoverMenuHandle::default(),
+            pending_menu_open: None,
+        }
+    }
+
+    fn sanitize_menu_items(items: Vec<OwnedMenuItem>) -> Vec<OwnedMenuItem> {
+        let mut cleaned = Vec::new();
+        let mut last_was_separator = true;
+        for item in items {
+            match item {
+                OwnedMenuItem::Separator => {
+                    if !last_was_separator {
+                        cleaned.push(item);
+                        last_was_separator = true;
+                    }
+                }
+                OwnedMenuItem::Submenu(ref submenu) if submenu.items.is_empty() => {}
+                OwnedMenuItem::SystemMenu(_) => {}
+                item => {
+                    cleaned.push(item);
+                    last_was_separator = false;
+                }
+            }
+        }
+        if let Some(OwnedMenuItem::Separator) = cleaned.last() {
+            cleaned.pop();
+        }
+        cleaned
+    }
+
+    fn add_items(menu: ContextMenu, items: Vec<OwnedMenuItem>) -> ContextMenu {
+        Self::sanitize_menu_items(items)
+            .into_iter()
+            .fold(menu, |menu, item| match item {
+                OwnedMenuItem::Separator => menu.separator(),
+                OwnedMenuItem::Action {
+                    name,
+                    action,
+                    checked,
+                    disabled,
+                    ..
+                } => menu.action_checked_with_disabled(name, action, checked, disabled),
+                OwnedMenuItem::Submenu(submenu) => Self::add_items(menu, submenu.items),
+                OwnedMenuItem::SystemMenu(_) => menu,
+            })
+    }
+
+    /// One popover with [`menus`]; with more than one, each starts under its name.
+    fn build_menu(menus: Vec<OwnedMenu>, window: &mut Window, cx: &mut App) -> Entity<ContextMenu> {
+        ContextMenu::build(window, cx, |menu, window, cx| {
+            // The focused element's actions run in its context (the editor's Copy, the pane's Close Editor).
+            let menu = menu.when_some(window.focused(cx), |menu, focused| menu.context(focused));
+            let headed = menus.len() > 1;
+            menus.into_iter().fold(menu, |menu, owned| {
+                let menu = if headed {
+                    menu.header(owned.name)
+                } else {
+                    menu
+                };
+                Self::add_items(menu, owned.items)
+            })
+        })
+    }
+
+    fn render_all_menus(&self) -> impl IntoElement {
+        let menus: Vec<OwnedMenu> = self
+            .entries
+            .iter()
+            .map(|entry| entry.menu.clone())
+            .collect();
+        div().id("og-menu-all").occlude().child(
+            PopoverMenu::new("og-menu-all-popover")
+                .menu(move |window, cx| Self::build_menu(menus.clone(), window, cx).into())
+                .trigger_with_tooltip(
+                    IconButton::new("og-menu-all-trigger", ui::IconName::Menu)
+                        .style(ButtonStyle::Subtle)
+                        .icon_size(IconSize::Small),
+                    Tooltip::text("Menu"),
+                )
+                .with_handle(self.all.clone()),
+        )
+    }
+
+    fn render_standard_menu(&self, entry: &MenuEntry) -> impl IntoElement {
+        let current_handle = entry.handle.clone();
+        let menu_name = entry.menu.name.clone();
+        let menu = entry.menu.clone();
+        let all_handles: Vec<_> = self
+            .entries
+            .iter()
+            .map(|entry| entry.handle.clone())
+            .collect();
+        div()
+            .id(format!("{}-menu-item", menu_name))
+            .occlude()
+            .child(
+                PopoverMenu::new(format!("{}-menu-popover", menu_name))
+                    .menu(move |window, cx| Self::build_menu(vec![menu.clone()], window, cx).into())
+                    .trigger(
+                        Button::new(
+                            SharedString::from(format!("{}-menu-trigger", menu_name)),
+                            menu_name,
+                        )
+                        .style(ButtonStyle::Subtle)
+                        .label_size(LabelSize::Small),
+                    )
+                    .with_handle(current_handle.clone()),
+            )
+            .on_hover(move |hover_enter, window, cx| {
+                if *hover_enter
+                    && all_handles.iter().any(|handle| handle.is_deployed())
+                    && !current_handle.is_deployed()
+                {
+                    all_handles.iter().for_each(|handle| handle.hide(cx));
+                    // Deferred so that this menu can take focus from the one it replaces.
+                    let handle = current_handle.clone();
+                    window.defer(cx, move |window, cx| handle.show(window, cx));
+                }
+            })
+    }
+
+    pub(crate) fn open_menu(&mut self, action: &OpenApplicationMenu, cx: &mut Context<Self>) {
+        self.pending_menu_open = Some(action.0.clone());
+        cx.notify();
+    }
+
+    pub(crate) fn navigate(&mut self, right: bool, window: &mut Window, cx: &mut Context<Self>) {
+        let Some(current) = self
+            .entries
+            .iter()
+            .position(|entry| entry.handle.is_deployed())
+        else {
+            return;
+        };
+        let count = self.entries.len();
+        let next = if right {
+            (current + 1) % count
+        } else {
+            (current + count - 1) % count
+        };
+        self.entries[current].handle.hide(cx);
+        let handle = self.entries[next].handle.clone();
+        cx.defer_in(window, move |_, window, cx| handle.show(window, cx));
+    }
+}
+
+impl Render for AppMenuBar {
+    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let narrow = window.viewport_size().width < NARROW;
+        if let Some(name) = self.pending_menu_open.take() {
+            let target = if narrow {
+                Some(self.all.clone())
+            } else {
+                self.entries
+                    .iter()
+                    .find(|entry| entry.menu.name.as_ref() == name)
+                    .or(self.entries.first())
+                    .map(|entry| entry.handle.clone())
+            };
+            if let Some(handle) = target.filter(|handle| !handle.is_deployed()) {
+                self.entries.iter().for_each(|entry| entry.handle.hide(cx));
+                self.all.hide(cx);
+                cx.defer_in(window, move |_, window, cx| handle.show(window, cx));
+            }
+        }
+        h_flex()
+            .key_context("ApplicationMenu")
+            .w_full()
+            .h(px(32.))
+            .px_1()
+            .gap_x_1()
+            .bg(cx.theme().colors().title_bar_background)
+            .border_b_1()
+            .border_color(cx.theme().colors().border_variant)
+            .when(narrow && !self.entries.is_empty(), |bar| {
+                bar.child(self.render_all_menus())
+            })
+            .when(!narrow, |bar| {
+                bar.children(
+                    self.entries
+                        .iter()
+                        .map(|entry| self.render_standard_menu(entry)),
+                )
+            })
+    }
+}
