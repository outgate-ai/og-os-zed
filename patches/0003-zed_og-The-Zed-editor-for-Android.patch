new file mode 100644
index 0000000..853693a
--- /dev/null
+++ b/crates/zed_og/src/filter.rs
@@ -0,0 +1,100 @@
+//! Which actions this build shows (command palette and menus). Names only, so the rule is tested on the host.
+#![cfg_attr(not(target_os = "android"), allow(dead_code))]
+
+/// Namespaces of features this build never initialises; their actions must not show in the palette or a menu.
+pub(crate) const HIDDEN_NAMESPACES: &[&str] = &[
+    "agent",
+    "assistant",
+    "auto_update",
+    "call",
+    "channel_modal",
+    "client",
+    "collab",
+    "copilot",
+    "edit_prediction",
+    "extensions",
+    "feedback",
+    "git_panel",
+    "language_models",
+    "terminal",
+    "git",
+    "zeta",
+];
+
+/// Actions a menu never offers: trust (unbound on purpose), a second window or a folder picker (the app has one
+/// window and no file system outside its own storage), and the actions of features left out.
+pub(crate) const NOT_IN_MENUS: &[&str] = &[
+    "workspace::ToggleWorktreeSecurity",
+    "workspace::NewWindow",
+    "workspace::Open",
+    "workspace::OpenFiles",
+    "workspace::AddFolderToProject",
+    "workspace::CloseProject",
+    "projects::OpenRecent",
+    "projects::OpenRemote",
+];
+
+/// Whether a menu may offer the action named `name` (`namespace::Name`).
+pub(crate) fn in_menu(name: &str) -> bool {
+    let Some((namespace, _)) = name.split_once("::") else {
+        return false;
+    };
+    !namespace.is_empty()
+        && !HIDDEN_NAMESPACES.contains(&namespace)
+        && !NOT_IN_MENUS.contains(&name)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::in_menu;
+
+    #[test]
+    fn editing_saving_and_navigation_are_offered() {
+        for name in [
+            "workspace::Save",
+            "workspace::SaveAll",
+            "pane::CloseActiveItem",
+            "editor::Undo",
+            "editor::Paste",
+            "buffer_search::Deploy",
+            "command_palette::Toggle",
+            "file_finder::Toggle",
+            "go_to_line::Toggle",
+        ] {
+            assert!(in_menu(name), "{name}");
+        }
+    }
+
+    #[test]
+    fn left_out_features_are_never_offered() {
+        for name in [
+            "terminal::Toggle",
+            "git::Commit",
+            "agent::NewThread",
+            "collab::ToggleMute",
+            "extensions::Install",
+            "auto_update::Check",
+        ] {
+            assert!(!in_menu(name), "{name}");
+        }
+    }
+
+    #[test]
+    fn trust_a_second_window_and_folder_pickers_are_never_offered() {
+        for name in [
+            "workspace::ToggleWorktreeSecurity",
+            "workspace::NewWindow",
+            "workspace::Open",
+            "workspace::OpenFiles",
+            "projects::OpenRecent",
+        ] {
+            assert!(!in_menu(name), "{name}");
+        }
+    }
+
+    #[test]
+    fn a_name_without_a_namespace_is_not_offered() {
+        assert!(!in_menu("Save"));
+        assert!(!in_menu(""));
+    }
+}
diff --git a/crates/zed_og/src/pending.rs b/crates/zed_og/src/pending.rs
new file mode 100644
index 0000000..27a1322
--- /dev/null
+++ b/crates/zed_og/src/pending.rs
@@ -0,0 +1,65 @@
+//! ZED2 F3: shared files that arrive before the first workspace window exists wait for it. Plain state, so the rule
+//! is tested on the host.
+#![cfg_attr(not(target_os = "android"), allow(dead_code))]
+
+use std::path::PathBuf;
+
+#[derive(Default)]
+pub(crate) struct PendingOpens {
+    ready: bool,
+    queue: Vec<PathBuf>,
+}
+
+impl PendingOpens {
+    /// A shared file's copy arrived: the path to open now, or None while it waits for the first window.
+    pub(crate) fn arrive(&mut self, path: PathBuf) -> Option<PathBuf> {
+        if self.ready {
+            return Some(path);
+        }
+        if !self.queue.contains(&path) {
+            self.queue.push(path);
+        }
+        None
+    }
+
+    /// A workspace window appeared: the paths to open in it. Only the first window takes them, each once.
+    pub(crate) fn window_ready(&mut self) -> Vec<PathBuf> {
+        self.ready = true;
+        std::mem::take(&mut self.queue)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::PendingOpens;
+    use std::path::PathBuf;
+
+    fn p(name: &str) -> PathBuf {
+        PathBuf::from(format!("/files/projects/external/t/{name}"))
+    }
+
+    #[test]
+    fn a_path_before_the_window_opens_once_when_it_appears() {
+        let mut pending = PendingOpens::default();
+        assert_eq!(pending.arrive(p("notes.txt")), None);
+        assert_eq!(pending.window_ready(), vec![p("notes.txt")]);
+        assert_eq!(pending.window_ready(), Vec::<PathBuf>::new());
+    }
+
+    #[test]
+    fn a_path_after_the_window_opens_at_once_and_is_not_queued() {
+        let mut pending = PendingOpens::default();
+        assert_eq!(pending.window_ready(), Vec::<PathBuf>::new());
+        assert_eq!(pending.arrive(p("notes.txt")), Some(p("notes.txt")));
+        assert_eq!(pending.window_ready(), Vec::<PathBuf>::new());
+    }
+
+    #[test]
+    fn the_same_path_twice_before_the_window_opens_once_and_order_is_kept() {
+        let mut pending = PendingOpens::default();
+        assert_eq!(pending.arrive(p("a.txt")), None);
+        assert_eq!(pending.arrive(p("b.txt")), None);
+        assert_eq!(pending.arrive(p("a.txt")), None);
+        assert_eq!(pending.window_ready(), vec![p("a.txt"), p("b.txt")]);
+    }
+}
