diff --git a/crates/gpui_android/src/gpui_android.rs b/crates/gpui_android/src/gpui_android.rs
new file mode 100644
index 0000000..f90a9d7
--- /dev/null
+++ b/crates/gpui_android/src/gpui_android.rs
@@ -0,0 +1,42 @@
+#![cfg(target_os = "android")]
+
+mod dispatcher;
+mod display;
+mod ime;
+mod input;
+mod logging;
+mod platform;
+mod window;
+
+use std::sync::Mutex;
+
+pub use android_activity::AndroidApp;
+pub use display::AndroidDisplay;
+pub use logging::init_logging;
+pub use platform::AndroidPlatform;
+
+static ANDROID_APP: Mutex<Option<AndroidApp>> = Mutex::new(None);
+
+/// Records the app handed to `android_main`; call it before creating the GPUI application.
+pub fn init(app: AndroidApp) {
+    init_logging();
+    std::panic::set_hook(Box::new(|info| {
+        let (file, line) = info
+            .location()
+            .map_or(("?", 0), |location| (location.file(), location.line()));
+        log::error!("gpui_android: E_PANIC {file}:{line}");
+        // Abort here so neither Rust's abort message (debuggerd) nor android-activity's panic log sees the payload.
+        std::process::abort();
+    }));
+    *ANDROID_APP
+        .lock()
+        .unwrap_or_else(|error| error.into_inner()) = Some(app);
+}
+
+pub fn android_app() -> AndroidApp {
+    ANDROID_APP
+        .lock()
+        .unwrap_or_else(|error| error.into_inner())
+        .clone()
+        .expect("gpui_android::init must run before the platform is created")
+}
diff --git a/crates/gpui_android/src/ime.rs b/crates/gpui_android/src/ime.rs
new file mode 100644
index 0000000..96ad1ce
--- /dev/null
+++ b/crates/gpui_android/src/ime.rs
@@ -0,0 +1,182 @@
+//! Bridge to ai.outgate.zed.ZedActivity: soft-keyboard text from its InputConnection and the system clipboard.
+//! Java calls the native methods on its UI thread; events are queued here and applied on the android_main thread.
+
+use std::sync::Mutex;
+
+use android_activity::AndroidAppWaker;
+use jni::{
+    EnvUnowned,
+    objects::{JClass, JString},
+};
+
+pub(crate) enum ImeEvent {
+    Commit(String),
+    Compose(String),
+    FinishComposing,
+    DeleteSurrounding {
+        before: usize,
+        after: usize,
+    },
+    Key {
+        key_code: i32,
+        meta_state: i32,
+        down: bool,
+    },
+    Insets {
+        bottom: i32,
+    },
+    Back,
+}
+
+static QUEUE: Mutex<Vec<ImeEvent>> = Mutex::new(Vec::new());
+static WAKER: Mutex<Option<AndroidAppWaker>> = Mutex::new(None);
+
+pub(crate) fn set_waker(waker: AndroidAppWaker) {
+    *WAKER.lock().unwrap_or_else(|e| e.into_inner()) = Some(waker);
+}
+
+pub(crate) fn drain() -> Vec<ImeEvent> {
+    std::mem::take(&mut *QUEUE.lock().unwrap_or_else(|e| e.into_inner()))
+}
+
+pub(crate) fn wake() {
+    if let Some(waker) = WAKER.lock().unwrap_or_else(|e| e.into_inner()).as_ref() {
+        waker.wake();
+    }
+}
+
+fn push(event: ImeEvent) {
+    QUEUE.lock().unwrap_or_else(|e| e.into_inner()).push(event);
+    if let Some(waker) = WAKER.lock().unwrap_or_else(|e| e.into_inner()).as_ref() {
+        waker.wake();
+    }
+}
+
+fn push_text(mut env: EnvUnowned<'_>, text: JString<'_>, make: fn(String) -> ImeEvent) {
+    let outcome = env.with_env(|env| -> jni::errors::Result<()> {
+        push(make(text.try_to_string(env)?));
+        Ok(())
+    });
+    outcome.resolve::<jni::errors::LogErrorAndDefault>();
+}
+
+#[unsafe(no_mangle)]
+extern "system" fn Java_ai_outgate_zed_ZedActivity_nativeCommitText<'local>(
+    env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+    text: JString<'local>,
+) {
+    push_text(env, text, ImeEvent::Commit);
+}
+
+#[unsafe(no_mangle)]
+extern "system" fn Java_ai_outgate_zed_ZedActivity_nativeSetComposingText<'local>(
+    env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+    text: JString<'local>,
+) {
+    push_text(env, text, ImeEvent::Compose);
+}
+
+#[unsafe(no_mangle)]
+extern "system" fn Java_ai_outgate_zed_ZedActivity_nativeFinishComposing<'local>(
+    _env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+) {
+    push(ImeEvent::FinishComposing);
+}
+
+#[unsafe(no_mangle)]
+extern "system" fn Java_ai_outgate_zed_ZedActivity_nativeDeleteSurrounding<'local>(
+    _env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+    before: i32,
+    after: i32,
+) {
+    push(ImeEvent::DeleteSurrounding {
+        before: before.max(0) as usize,
+        after: after.max(0) as usize,
+    });
+}
+
+#[unsafe(no_mangle)]
+extern "system" fn Java_ai_outgate_zed_ZedActivity_nativeKey<'local>(
+    _env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+    key_code: i32,
+    meta_state: i32,
+    down: jni::sys::jboolean,
+) {
+    push(ImeEvent::Key {
+        key_code,
+        meta_state,
+        down,
+    });
+}
+
+#[unsafe(no_mangle)]
+extern "system" fn Java_ai_outgate_zed_ZedActivity_nativeBack<'local>(
+    _env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+) {
+    push(ImeEvent::Back);
+}
+
+#[unsafe(no_mangle)]
+extern "system" fn Java_ai_outgate_zed_ZedActivity_nativeInsets<'local>(
+    _env: EnvUnowned<'local>,
+    _class: JClass<'local>,
+    top: i32,
+    bottom: i32,
+) {
+    let _ = top;
+    push(ImeEvent::Insets { bottom });
+}
+
+jni::bind_java_type! {
+    ZedActivity => "ai.outgate.zed.ZedActivity",
+    methods {
+        fn show_keyboard(show: bool),
+        fn read_clipboard() -> JString,
+        fn write_clipboard(text: JString),
+    }
+}
+
+fn with_activity<T>(
+    f: impl FnOnce(&mut jni::Env, &ZedActivity) -> jni::errors::Result<T>,
+) -> Option<T> {
+    let app = crate::android_app();
+    // SAFETY: vm_as_ptr is the process JavaVM, valid for the process lifetime.
+    let vm = unsafe { jni::JavaVM::from_raw(app.vm_as_ptr().cast()) };
+    vm.attach_current_thread(|env| -> jni::errors::Result<T> {
+        let raw = app.activity_as_ptr() as jni::sys::jobject;
+        // SAFETY: an unowned global reference that stays valid while `app` is alive; the cast takes no ownership.
+        // The cast fails (and nothing is called) when the activity is a plain NativeActivity.
+        let activity = unsafe { env.as_cast_raw::<jni::refs::Global<ZedActivity>>(&raw)? };
+        f(env, &activity)
+    })
+    .ok()
+}
+
+pub(crate) fn show_keyboard(show: bool) {
+    with_activity(|env, activity| activity.show_keyboard(env, show));
+}
+
+pub(crate) fn read_clipboard() -> Option<String> {
+    with_activity(|env, activity| {
+        let text = activity.read_clipboard(env)?;
+        if text.is_null() {
+            return Ok(None);
+        }
+        text.try_to_string(env).map(Some)
+    })
+    .flatten()
+}
+
+pub(crate) fn write_clipboard(text: &str) -> bool {
+    with_activity(|env, activity| {
+        let text = JString::from_str(env, text)?;
+        activity.write_clipboard(env, &text)
+    })
+    .is_some()
+}
