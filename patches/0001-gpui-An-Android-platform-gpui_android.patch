+use std::{
+    collections::{HashMap, hash_map::Entry},
+    time::{Duration, Instant},
+};
+
+use android_activity::{
+    AndroidApp,
+    input::{
+        Axis, Button, KeyAction, KeyCharacterMap, KeyEvent, KeyMapChar, Keycode, MetaState,
+        MotionAction, MotionEvent, ToolType,
+    },
+};
+use gpui::{
+    Capslock, KeyDownEvent, KeyUpEvent, Keystroke, Modifiers, ModifiersChangedEvent, MouseButton,
+    MouseDownEvent, MouseMoveEvent, MouseUpEvent, Pixels, PlatformInput, Point, ScrollDelta,
+    ScrollWheelEvent, TouchPhase, point, px,
+};
+
+const DOUBLE_CLICK_INTERVAL: Duration = Duration::from_millis(400);
+const DOUBLE_CLICK_DISTANCE: f32 = 24.;
+const TOUCH_SLOP: f32 = 8.;
+const TOUCH_HOLD: Duration = Duration::from_millis(80);
+const META_CTRL_MASK: u32 = 0x1000 | 0x2000 | 0x4000;
+
+#[derive(Default)]
+pub(crate) struct InputState {
+    pressed: Option<MouseButton>,
+    scroll_anchor: Option<Point<Pixels>>,
+    scrolling: bool,
+    pending_down: Option<(Point<Pixels>, Instant)>,
+    last_click: Option<(Instant, Point<Pixels>, usize)>,
+    key_maps: HashMap<i32, KeyCharacterMap>,
+}
+
+pub(crate) struct Translated {
+    pub(crate) events: Vec<PlatformInput>,
+    pub(crate) modifiers: Option<(Modifiers, Capslock)>,
+}
+
+fn modifiers_of(meta: MetaState) -> Modifiers {
+    Modifiers {
+        control: meta.ctrl_on(),
+        alt: meta.alt_on(),
+        shift: meta.shift_on(),
+        platform: meta.meta_on(),
+        function: meta.function_on(),
+    }
+}
+
+fn capslock_of(meta: MetaState) -> Capslock {
+    Capslock {
+        on: meta.caps_lock_on(),
+    }
+}
+
+impl InputState {
+    fn click_count(&mut self, position: Point<Pixels>) -> usize {
+        let now = Instant::now();
+        let count = match self.last_click {
+            Some((at, last, count))
+                if now.duration_since(at) <= DOUBLE_CLICK_INTERVAL
+                    && (position.x - last.x).abs() <= px(DOUBLE_CLICK_DISTANCE)
+                    && (position.y - last.y).abs() <= px(DOUBLE_CLICK_DISTANCE) =>
+            {
+                count + 1
+            }
+            _ => 1,
+        };
+        self.last_click = Some((now, position, count));
+        count
+    }
+
+    fn click_count_for_release(&self) -> usize {
+        self.last_click.map_or(1, |(_, _, count)| count)
+    }
+
+    pub(crate) fn motion(
+        &mut self,
+        event: &MotionEvent<'_>,
+        scale_factor: f32,
+        modifiers: Modifiers,
+    ) -> Vec<PlatformInput> {
+        let to_logical =
+            |x: f32, y: f32| -> Point<Pixels> { point(px(x / scale_factor), px(y / scale_factor)) };
+        let index = event.pointer_index();
+        let pointer = event.pointer_at_index(index.min(event.pointer_count().saturating_sub(1)));
+        let position = to_logical(pointer.x(), pointer.y());
+        let mut events = Vec::new();
+
+        if pointer.tool_type() == ToolType::Mouse {
+            match event.action() {
+                MotionAction::ButtonPress => {
+                    let button = mouse_button(event.action_button());
+                    self.pressed = Some(button);
+                    events.push(PlatformInput::MouseDown(MouseDownEvent {
+                        button,
+                        position,
+                        modifiers,
+                        click_count: self.click_count(position),
+                        first_mouse: false,
+                    }));
+                }
+                MotionAction::ButtonRelease => {
+                    let button = mouse_button(event.action_button());
+                    self.pressed = held_button(event.button_state().0);
+                    events.push(PlatformInput::MouseUp(MouseUpEvent {
+                        button,
+                        position,
+                        modifiers,
+                        click_count: self.click_count_for_release(),
+                    }));
+                }
+                MotionAction::Move | MotionAction::HoverMove => {
+                    events.push(PlatformInput::MouseMove(MouseMoveEvent {
+                        position,
+                        pressed_button: self.pressed,
+                        modifiers,
+                    }));
+                }
+                MotionAction::Scroll => {
+                    let delta = point(
+                        -pointer.axis_value(Axis::Hscroll),
+                        pointer.axis_value(Axis::Vscroll),
+                    );
+                    events.push(PlatformInput::ScrollWheel(ScrollWheelEvent {
+                        position,
+                        delta: ScrollDelta::Lines(delta),
+                        modifiers,
+                        touch_phase: TouchPhase::Moved,
+                    }));
+                }
+                _ => {}
+            }
+            return events;
+        }
+
+        let centroid = |skip: Option<usize>| {
+            let (x, y, count) = event
+                .pointers()
+                .filter(|p| Some(p.pointer_index()) != skip)
+                .fold((0., 0., 0.), |(x, y, n), p| (x + p.x(), y + p.y(), n + 1.));
+            let count: f32 = if count > 0. { count } else { 1. };
+            to_logical(x / count, y / count)
+        };
+        let scroll = |position, delta, touch_phase| {
+            PlatformInput::ScrollWheel(ScrollWheelEvent {
+                position,
+                delta: ScrollDelta::Pixels(delta),
+                modifiers,
+                touch_phase,
+            })
+        };
+
+        match event.action() {
+            MotionAction::Down => {
+                self.scroll_anchor = None;
+                self.scrolling = false;
+                self.pressed = None;
+                self.pending_down = Some((position, Instant::now()));
+            }
+            MotionAction::PointerDown => {
+                self.pending_down = None;
+                if self.pressed.take().is_some() {
+                    let first = event.pointer_at_index(0);
+                    events.push(PlatformInput::MouseUp(MouseUpEvent {
+                        button: MouseButton::Left,
+                        position: to_logical(first.x(), first.y()),
+                        modifiers,
+                        click_count: self.click_count_for_release(),
+                    }));
+                }
+                let anchor = centroid(None);
+                self.scroll_anchor = Some(anchor);
+                if !self.scrolling {
+                    self.scrolling = true;
+                    events.push(scroll(anchor, Point::default(), TouchPhase::Started));
+                }
+            }
+            MotionAction::Move => {
+                if let Some(anchor) = self.scroll_anchor {
+                    if self.scrolling && event.pointer_count() >= 2 {
+                        let current = centroid(None);
+                        self.scroll_anchor = Some(current);
+                        events.push(scroll(current, current - anchor, TouchPhase::Moved));
+                    }
+                } else if let Some((down_at, since)) = self.pending_down {
+                    let moved = (position.x - down_at.x).abs() > px(TOUCH_SLOP)
+                        || (position.y - down_at.y).abs() > px(TOUCH_SLOP);
+                    if moved || since.elapsed() >= TOUCH_HOLD {
+                        self.pending_down = None;
+                        self.pressed = Some(MouseButton::Left);
+                        events.push(PlatformInput::MouseDown(MouseDownEvent {
+                            button: MouseButton::Left,
+                            position: down_at,
+                            modifiers,
+                            click_count: self.click_count(down_at),
+                            first_mouse: false,
+                        }));
+                        events.push(PlatformInput::MouseMove(MouseMoveEvent {
+                            position,
+                            pressed_button: self.pressed,
+                            modifiers,
+                        }));
+                    }
+                } else if self.pressed.is_some() {
+                    events.push(PlatformInput::MouseMove(MouseMoveEvent {
+                        position,
+                        pressed_button: self.pressed,
+                        modifiers,
+                    }));
+                }
+            }
+            MotionAction::PointerUp => {
+                if self.scroll_anchor.is_some() {
+                    let remaining = centroid(Some(event.pointer_index()));
+                    self.scroll_anchor = Some(remaining);
+                    if event.pointer_count() <= 2 && self.scrolling {
+                        self.scrolling = false;
+                        events.push(scroll(remaining, Point::default(), TouchPhase::Ended));
+                    }
+                }
+            }
+            MotionAction::Up => {
+                if let Some((down_at, _)) = self.pending_down.take() {
+                    let click_count = self.click_count(down_at);
+                    events.push(PlatformInput::MouseDown(MouseDownEvent {
+                        button: MouseButton::Left,
+                        position: down_at,
+                        modifiers,
+                        click_count,
+                        first_mouse: false,
+                    }));
+                    events.push(PlatformInput::MouseUp(MouseUpEvent {
+                        button: MouseButton::Left,
+                        position: down_at,
+                        modifiers,
+                        click_count,
+                    }));
+                } else if self.scroll_anchor.take().is_none() && self.pressed.take().is_some() {
+                    self.scrolling = false;
+                    events.push(PlatformInput::MouseUp(MouseUpEvent {
+                        button: MouseButton::Left,
+                        position,
+                        modifiers,
+                        click_count: self.click_count_for_release(),
+                    }));
+                }
+            }
+            MotionAction::Cancel => {
+                self.pending_down = None;
+                if let Some(anchor) = self.scroll_anchor.take()
+                    && std::mem::take(&mut self.scrolling)
+                {
+                    events.push(scroll(anchor, Point::default(), TouchPhase::Ended));
+                }
+                if self.pressed.take().is_some() {
+                    events.push(PlatformInput::MouseUp(MouseUpEvent {
+                        button: MouseButton::Left,
+                        position,
+                        modifiers,
+                        click_count: self.click_count_for_release(),
+                    }));
+                }
+            }
+            _ => {}
+        }
+        events
+    }
+
+    /// Whether a touch is waiting for its hold time to pass before it becomes a press.
+    pub(crate) fn hold_pending(&self) -> bool {
+        self.pending_down.is_some()
+    }
+
+    /// Turns a touch held still for [`TOUCH_HOLD`] into a press, without waiting for it to move.
+    pub(crate) fn poll_hold(&mut self, modifiers: Modifiers) -> Option<PlatformInput> {
+        let (down_at, since) = self.pending_down?;
+        if since.elapsed() < TOUCH_HOLD {
+            return None;
+        }
+        self.pending_down = None;
+        self.pressed = Some(MouseButton::Left);
+        Some(PlatformInput::MouseDown(MouseDownEvent {
+            button: MouseButton::Left,
+            position: down_at,
+            modifiers,
+            click_count: self.click_count(down_at),
+            first_mouse: false,
+        }))
+    }
+
+    /// A key the soft keyboard sends through its InputConnection (usually delete or enter).
+    pub(crate) fn soft_key(key_code: i32, meta_state: i32, down: bool) -> Option<PlatformInput> {
+        let (key, key_char) = named_key(Keycode::from(key_code as u32))?;
+        let keystroke = Keystroke {
+            modifiers: modifiers_of(MetaState(meta_state as u32)),
+            key: key.to_string(),
+            key_char: key_char.map(str::to_string),
+        };
+        Some(if down {
+            PlatformInput::KeyDown(KeyDownEvent {
+                keystroke,
+                is_held: false,
+                prefer_character_input: false,
+            })
+        } else {
+            PlatformInput::KeyUp(KeyUpEvent { keystroke })
+        })
+    }
+
+    pub(crate) fn key(&mut self, app: &AndroidApp, event: &KeyEvent<'_>) -> Option<Translated> {
+        let meta = event.meta_state();
+        let mut modifiers = modifiers_of(meta);
+        let capslock = capslock_of(meta);
+        let key_code = event.key_code();
+
+        if is_modifier(key_code) {
+            return Some(Translated {
+                events: vec![PlatformInput::ModifiersChanged(ModifiersChangedEvent {
+                    modifiers,
+                    capslock,
+                })],
+                modifiers: Some((modifiers, capslock)),
+            });
+        }
+
+        let is_down = match event.action() {
+            KeyAction::Down => true,
+            KeyAction::Up => false,
+            _ => return None,
+        };
+
+        let (key, key_char) = match named_key(key_code) {
+            Some((name, key_char)) => (name.to_string(), key_char.map(str::to_string)),
+            None => {
+                let device_id = event.device_id();
+                let base = self.character(app, device_id, key_code, typing_meta(meta));
+                let alt_gr = if meta.alt_right_on() {
+                    self.character(
+                        app,
+                        device_id,
+                        key_code,
+                        MetaState(meta.0 & !META_CTRL_MASK),
+                    )
+                    .filter(|c| !c.is_control() && Some(*c) != base)
+                } else {
+                    None
+                };
+                let typed = match alt_gr {
+                    Some(c) => {
+                        modifiers.alt = false;
+                        modifiers.control = false;
+                        c
+                    }
+                    None => base?,
+                };
+                let key = if alt_gr.is_some() || typed.is_ascii_graphic() {
+                    typed.to_ascii_lowercase().to_string()
+                } else {
+                    self.character(app, device_id, key_code, MetaState(0))
+                        .filter(char::is_ascii_graphic)
+                        .unwrap_or(typed)
+                        .to_lowercase()
+                        .to_string()
+                };
+                if modifiers.shift && key.to_lowercase() == key.to_uppercase() {
+                    modifiers.shift = false;
+                }
+                let key_char = (!typed.is_control()).then(|| typed.to_string());
+                (key, key_char)
+            }
+        };
+
+        let keystroke = Keystroke {
+            modifiers,
+            key,
+            key_char,
+        };
+        let input = if is_down {
+            PlatformInput::KeyDown(KeyDownEvent {
+                keystroke,
+                is_held: event.repeat_count() > 0,
+                prefer_character_input: false,
+            })
+        } else {
+            PlatformInput::KeyUp(KeyUpEvent { keystroke })
+        };
+        Some(Translated {
+            events: vec![input],
+            modifiers: Some((modifiers_of(meta), capslock)),
+        })
+    }
+
+    fn character(
+        &mut self,
+        app: &AndroidApp,
+        device_id: i32,
+        key_code: Keycode,
+        meta: MetaState,
+    ) -> Option<char> {
+        if device_id == 0 {
+            return None;
+        }
+        let map = match self.key_maps.entry(device_id) {
+            Entry::Occupied(entry) => entry.into_mut(),
+            Entry::Vacant(entry) => match app.device_key_character_map(device_id) {
+                Ok(map) => entry.insert(map),
+                Err(_) => {
+                    log::warn!("gpui_android: no key character map (E_KCM)");
+                    return None;
+                }
+            },
+        };
+        match map.get(key_code, meta) {
+            Ok(KeyMapChar::Unicode(c)) => Some(c),
+            _ => None,
+        }
+    }
+}
+
+fn typing_meta(meta: MetaState) -> MetaState {
+    const SHIFT_AND_CAPS: u32 = 0x1 | 0x40 | 0x80 | 0x0010_0000;
+    MetaState(meta.0 & SHIFT_AND_CAPS)
+}
+
+fn held_button(state: u32) -> Option<MouseButton> {
+    const PRIMARY: u32 = 1;
+    const SECONDARY: u32 = 2;
+    const TERTIARY: u32 = 4;
+    if state & PRIMARY != 0 {
+        Some(MouseButton::Left)
+    } else if state & SECONDARY != 0 {
+        Some(MouseButton::Right)
+    } else if state & TERTIARY != 0 {
+        Some(MouseButton::Middle)
+    } else {
+        None
+    }
+}
+
+fn mouse_button(button: Button) -> MouseButton {
+    match button {
+        Button::Secondary | Button::StylusSecondary => MouseButton::Right,
+        Button::Tertiary => MouseButton::Middle,
+        _ => MouseButton::Left,
+    }
+}
+
+fn is_modifier(key_code: Keycode) -> bool {
+    matches!(
+        key_code,
+        Keycode::ShiftLeft
+            | Keycode::ShiftRight
+            | Keycode::CtrlLeft
+            | Keycode::CtrlRight
+            | Keycode::AltLeft
+            | Keycode::AltRight
+            | Keycode::MetaLeft
+            | Keycode::MetaRight
+            | Keycode::Function
+            | Keycode::CapsLock
+    )
+}
+
+fn named_key(key_code: Keycode) -> Option<(&'static str, Option<&'static str>)> {
+    Some(match key_code {
+        Keycode::Enter | Keycode::NumpadEnter => ("enter", None),
+        Keycode::Del => ("backspace", None),
+        Keycode::ForwardDel => ("delete", None),
+        Keycode::Tab => ("tab", None),
+        Keycode::Escape => ("escape", None),
+        Keycode::Space => ("space", Some(" ")),
+        Keycode::DpadLeft => ("left", None),
+        Keycode::DpadRight => ("right", None),
+        Keycode::DpadUp => ("up", None),
+        Keycode::DpadDown => ("down", None),
+        Keycode::MoveHome => ("home", None),
+        Keycode::MoveEnd => ("end", None),
+        Keycode::PageUp => ("pageup", None),
+        Keycode::PageDown => ("pagedown", None),
+        Keycode::Insert => ("insert", None),
+        Keycode::F1 => ("f1", None),
+        Keycode::F2 => ("f2", None),
+        Keycode::F3 => ("f3", None),
+        Keycode::F4 => ("f4", None),
+        Keycode::F5 => ("f5", None),
+        Keycode::F6 => ("f6", None),
+        Keycode::F7 => ("f7", None),
+        Keycode::F8 => ("f8", None),
+        Keycode::F9 => ("f9", None),
+        Keycode::F10 => ("f10", None),
+        Keycode::F11 => ("f11", None),
+        Keycode::F12 => ("f12", None),
+        _ => return None,
+    })
+}
diff --git a/crates/gpui_android/src/logging.rs b/crates/gpui_android/src/logging.rs
new file mode 100644
index 0000000..40bb1e2
--- /dev/null
+++ b/crates/gpui_android/src/logging.rs
@@ -0,0 +1,22 @@
+use log::LevelFilter;
+
+pub fn init_logging() {
+    let max_level = if cfg!(debug_assertions) {
+        LevelFilter::Warn
+    } else {
+        LevelFilter::Error
+    };
+    // Only targets that log fixed codes reach logcat (F10): Zed's own crates can put paths or text in messages.
+    let filter = android_logger::FilterBuilder::new()
+        .filter_level(log::LevelFilter::Off)
+        // gpui_android logs codes only, so its informational codes (I_*) are kept in every build.
+        .filter_module("gpui_android", LevelFilter::Info.max(max_level))
+        .filter_module("zed_og", max_level)
+        .build();
+    android_logger::init_once(
+        android_logger::Config::default()
+            .with_max_level(LevelFilter::Info.max(max_level))
+            .with_filter(filter)
+            .with_tag("zed"),
+    );
+}
