@@ -0,0 +1,781 @@
+use std::{
+    borrow::Cow,
+    cell::{Cell, RefCell},
+    path::{Path, PathBuf},
+    rc::{Rc, Weak},
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+use android_activity::{
+    AndroidApp, InputStatus, MainEvent, PollEvent,
+    input::{InputEvent, KeyAction, Keycode},
+    ndk::{configuration::UiModeNight, native_window::NativeWindow},
+};
+use anyhow::{Result, anyhow};
+use futures::channel::oneshot;
+use gpui::{
+    Action, AnyWindowHandle, BackgroundExecutor, ClipboardItem, CursorStyle, DummyKeyboardMapper,
+    ForegroundExecutor, Keymap, Menu, MenuItem, PathPromptOptions, Platform, PlatformDisplay,
+    PlatformInput, PlatformKeyboardLayout, PlatformKeyboardMapper, PlatformTextSystem,
+    PlatformWindow, PriorityQueueReceiver, RunnableVariant, Task, ThermalState, WindowAppearance,
+    WindowParams,
+};
+use gpui_wgpu::{CosmicTextSystem, GpuContext};
+
+use crate::{
+    dispatcher::AndroidDispatcher,
+    display::AndroidDisplay,
+    ime::ImeEvent,
+    input::InputState,
+    window::{AndroidWindow, WindowInner},
+};
+
+const FRAME_INTERVAL: Duration = Duration::from_millis(16);
+// gpui throttles an inactive window to one frame per 33 ms and skips the frames in between, so keep ticking for a
+// few frames after the last one that drew before the loop is allowed to block.
+const IDLE_TICKS: u32 = 3;
+// A forced frame that keeps not drawing (or a GPU that keeps getting lost) is retried this many times, then the
+// loop is allowed to idle until the next event instead of waking at 60 Hz.
+const FORCE_RETRIES: u32 = 8;
+
+static FINISH_FAILED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+const MAIN_TASK_BUDGET: Duration = Duration::from_millis(8);
+
+static BUNDLED_FONTS: &[&[u8]] = &[
+    include_bytes!("../../../assets/fonts/ibm-plex-sans/IBMPlexSans-Regular.ttf"),
+    include_bytes!("../../../assets/fonts/ibm-plex-sans/IBMPlexSans-Italic.ttf"),
+    include_bytes!("../../../assets/fonts/ibm-plex-sans/IBMPlexSans-SemiBold.ttf"),
+    include_bytes!("../../../assets/fonts/ibm-plex-sans/IBMPlexSans-SemiBoldItalic.ttf"),
+    include_bytes!("../../../assets/fonts/lilex/Lilex-Regular.ttf"),
+    include_bytes!("../../../assets/fonts/lilex/Lilex-Bold.ttf"),
+    include_bytes!("../../../assets/fonts/lilex/Lilex-Italic.ttf"),
+    include_bytes!("../../../assets/fonts/lilex/Lilex-BoldItalic.ttf"),
+];
+
+#[derive(Default)]
+struct Callbacks {
+    open_urls: Option<Box<dyn FnMut(Vec<String>)>>,
+    quit: Option<Box<dyn FnMut()>>,
+    reopen: Option<Box<dyn FnMut()>>,
+    app_menu_action: Option<Box<dyn FnMut(&dyn Action)>>,
+    will_open_app_menu: Option<Box<dyn FnMut()>>,
+    validate_app_menu_command: Option<Box<dyn FnMut(&dyn Action) -> bool>>,
+    keyboard_layout_change: Option<Box<dyn FnMut()>>,
+    thermal_state_change: Option<Box<dyn FnMut()>>,
+}
+
+pub struct AndroidPlatform {
+    app: AndroidApp,
+    background_executor: BackgroundExecutor,
+    foreground_executor: ForegroundExecutor,
+    main_receiver: RefCell<PriorityQueueReceiver<RunnableVariant>>,
+    text_system: Arc<dyn PlatformTextSystem>,
+    gpu_context: GpuContext,
+    native_window: RefCell<Option<NativeWindow>>,
+    window: RefCell<Weak<WindowInner>>,
+    active_window: Cell<Option<AnyWindowHandle>>,
+    input: RefCell<InputState>,
+    clipboard: RefCell<Option<ClipboardItem>>,
+    callbacks: RefCell<Callbacks>,
+    resumed: Cell<bool>,
+    force_render: Cell<bool>,
+    quitting: Cell<bool>,
+    bottom_inset: Cell<i32>,
+    keyboard_shown: Cell<bool>,
+    paste_requested: Cell<bool>,
+}
+
+impl AndroidPlatform {
+    pub fn new(app: AndroidApp) -> Self {
+        let (main_sender, main_receiver) = PriorityQueueReceiver::new();
+        let dispatcher = Arc::new(AndroidDispatcher::new(main_sender, app.create_waker()));
+        crate::ime::set_waker(app.create_waker());
+        let background_executor = BackgroundExecutor::new(dispatcher.clone());
+        let foreground_executor = ForegroundExecutor::new(dispatcher);
+
+        let text_system = Arc::new(CosmicTextSystem::new_without_system_fonts("IBM Plex Sans"));
+        let fonts = BUNDLED_FONTS
+            .iter()
+            .map(|bytes| Cow::Borrowed(*bytes))
+            .collect();
+        if text_system.add_fonts(fonts).is_err() {
+            log::error!("gpui_android: bundled fonts failed to load (E_FONTS)");
+        }
+
+        Self {
+            app,
+            background_executor,
+            foreground_executor,
+            main_receiver: RefCell::new(main_receiver),
+            text_system,
+            gpu_context: Rc::new(RefCell::new(None)),
+            native_window: RefCell::new(None),
+            window: RefCell::new(Weak::new()),
+            active_window: Cell::new(None),
+            input: RefCell::new(InputState::default()),
+            clipboard: RefCell::new(None),
+            callbacks: RefCell::new(Callbacks::default()),
+            resumed: Cell::new(false),
+            force_render: Cell::new(true),
+            quitting: Cell::new(false),
+            bottom_inset: Cell::new(0),
+            keyboard_shown: Cell::new(false),
+            paste_requested: Cell::new(false),
+        }
+    }
+
+    fn scale_factor(&self) -> f32 {
+        self.app
+            .config()
+            .density()
+            .map_or(1., |dpi| dpi as f32 / 160.)
+    }
+
+    fn appearance(&self) -> WindowAppearance {
+        match self.app.config().ui_mode_night() {
+            UiModeNight::Yes => WindowAppearance::Dark,
+            _ => WindowAppearance::Light,
+        }
+    }
+
+    fn window(&self) -> Option<Rc<WindowInner>> {
+        let window = self.window.borrow().upgrade();
+        if window.is_none() {
+            self.active_window.set(None);
+        }
+        window
+    }
+
+    fn can_draw(&self) -> bool {
+        self.resumed.get() && self.window().is_some_and(|window| window.has_surface())
+    }
+
+    fn handle_main_event(&self, event: MainEvent<'_>) {
+        match event {
+            MainEvent::InitWindow { .. } => {
+                let native_window = self.app.native_window();
+                *self.native_window.borrow_mut() = native_window.clone();
+                if let (Some(window), Some(native_window)) = (self.window(), native_window) {
+                    window.attach_surface(native_window);
+                }
+                self.force_render.set(true);
+            }
+            MainEvent::TerminateWindow { .. } => {
+                if let Some(window) = self.window() {
+                    window.detach_surface();
+                }
+                *self.native_window.borrow_mut() = None;
+            }
+            MainEvent::WindowResized { .. }
+            | MainEvent::ContentRectChanged { .. }
+            | MainEvent::ConfigChanged { .. } => {
+                if let Some(window) = self.window() {
+                    window.update_geometry(self.scale_factor());
+                    window.set_appearance(self.appearance());
+                }
+                self.force_render.set(true);
+            }
+            MainEvent::RedrawNeeded { .. } => self.force_render.set(true),
+            MainEvent::GainedFocus => {
+                if let Some(window) = self.window() {
+                    window.set_active(true);
+                }
+            }
+            MainEvent::LostFocus => {
+                if let Some(window) = self.window() {
+                    window.set_active(false);
+                }
+            }
+            MainEvent::Resume { .. } => {
+                self.resumed.set(true);
+                self.force_render.set(true);
+            }
+            MainEvent::Pause => self.resumed.set(false),
+            MainEvent::LowMemory => log::warn!("gpui_android: W_LOWMEM"),
+            MainEvent::Destroy => self.quitting.set(true),
+            _ => {}
+        }
+    }
+
+    fn drain_input(&self) -> bool {
+        let Ok(mut iter) = self.app.input_events_iter() else {
+            return false;
+        };
+        let mut any = false;
+        loop {
+            let mut pending = Vec::new();
+            let read = iter.next(|event| {
+                let Some(window) = self.window() else {
+                    return InputStatus::Unhandled;
+                };
+                match event {
+                    InputEvent::MotionEvent(motion) => {
+                        pending = self.input.borrow_mut().motion(
+                            motion,
+                            window.scale_factor(),
+                            window.modifiers(),
+                        );
+                        InputStatus::Handled
+                    }
+                    InputEvent::KeyEvent(key) if key.key_code() == Keycode::Back => {
+                        if key.action() == KeyAction::Up {
+                            self.handle_back(&window);
+                        }
+                        InputStatus::Handled
+                    }
+                    InputEvent::KeyEvent(key) => {
+                        let Some(translated) = self.input.borrow_mut().key(&self.app, key) else {
+                            return InputStatus::Unhandled;
+                        };
+                        if let Some((modifiers, capslock)) = translated.modifiers {
+                            window.set_modifiers(modifiers, capslock);
+                        }
+                        let mut handled = false;
+                        for event in translated.events {
+                            handled |= self.dispatch_input(&window, event);
+                        }
+                        if handled {
+                            InputStatus::Handled
+                        } else {
+                            InputStatus::Unhandled
+                        }
+                    }
+                    _ => InputStatus::Unhandled,
+                }
+            });
+            if let Some(window) = self.window() {
+                for event in pending {
+                    self.dispatch_input(&window, event);
+                }
+            }
+            if !read {
+                break;
+            }
+            any = true;
+        }
+        any
+    }
+
+    fn dispatch_input(&self, window: &WindowInner, event: PlatformInput) -> bool {
+        let position = match &event {
+            PlatformInput::MouseDown(event) => Some(event.position),
+            PlatformInput::MouseUp(event) => Some(event.position),
+            PlatformInput::MouseMove(event) => Some(event.position),
+            PlatformInput::ScrollWheel(event) => Some(event.position),
+            _ => None,
+        };
+        if let Some(position) = position {
+            window.set_mouse_position(position);
+        }
+        let is_tap = matches!(event, PlatformInput::MouseUp(_));
+        // The system clipboard is read only for an explicit paste keystroke (L5): other callers, such as the project
+        // panel's context menu, see the in-process clipboard and never trigger Android's paste notice.
+        self.paste_requested.set(matches!(
+            &event,
+            PlatformInput::KeyDown(key)
+                if key.keystroke.key == "paste"
+                    || (key.keystroke.key == "v" && key.keystroke.modifiers.control)
+                    || (key.keystroke.key == "insert" && key.keystroke.modifiers.shift)
+        ));
+        let handled = window.handle_input(event);
+        self.paste_requested.set(false);
+        // A tap in a text input brings the keyboard back after the user dismissed it.
+        if is_tap && window.has_input_handler() {
+            self.keyboard_shown.set(true);
+            crate::ime::show_keyboard(true);
+        }
+        handled
+    }
+
+    /// Back is sent as an `android_back` keystroke, a key name no upstream keymap binds (the default keymap maps
+    /// `back`, the mouse button, to pane::GoBack). The app binds it per context; if nothing handles it, the window is
+    /// asked whether it may close. The loop finishes the Activity once the window is gone.
+    fn handle_back(&self, window: &WindowInner) {
+        let back = |down| {
+            let keystroke = gpui::Keystroke {
+                modifiers: gpui::Modifiers::default(),
+                key: "android_back".into(),
+                key_char: None,
+            };
+            if down {
+                PlatformInput::KeyDown(gpui::KeyDownEvent {
+                    keystroke,
+                    is_held: false,
+                    prefer_character_input: false,
+                })
+            } else {
+                PlatformInput::KeyUp(gpui::KeyUpEvent { keystroke })
+            }
+        };
+        let handled = window.handle_input(back(true));
+        window.handle_input(back(false));
+        if !handled && window.should_close() {
+            self.quit();
+        }
+    }
+
+    fn apply_ime(&self) -> bool {
+        let events = crate::ime::drain();
+        if events.is_empty() {
+            return false;
+        }
+        let window = self.window();
+        for event in events {
+            if let ImeEvent::Insets { bottom } = event {
+                self.bottom_inset.set(bottom);
+                if let Some(window) = &window {
+                    window.set_bottom_inset(bottom);
+                }
+                self.force_render.set(true);
+                continue;
+            }
+            // Text and keys before the window exists have nowhere to go.
+            let Some(window) = &window else {
+                continue;
+            };
+            match event {
+                ImeEvent::Commit(text) => {
+                    window.with_input_handler(|handler| handler.replace_text_in_range(None, &text));
+                }
+                ImeEvent::Compose(text) => {
+                    window.with_input_handler(|handler| {
+                        handler.replace_and_mark_text_in_range(None, &text, None)
+                    });
+                }
+                ImeEvent::FinishComposing => {
+                    window.with_input_handler(|handler| handler.unmark_text());
+                }
+                ImeEvent::DeleteSurrounding { before, after } => {
+                    window.with_input_handler(|handler| {
+                        // Android's contract keeps the selection: delete after it first, then before it.
+                        if let Some(selection) = handler.selected_text_range(false) {
+                            let range = selection.range;
+                            if after > 0 {
+                                handler
+                                    .replace_text_in_range(Some(range.end..range.end + after), "");
+                            }
+                            if before > 0 {
+                                let start = range.start.saturating_sub(before);
+                                handler.replace_text_in_range(Some(start..range.start), "");
+                            }
+                        }
+                    });
+                }
+                ImeEvent::Insets { .. } => {}
+                ImeEvent::Back => self.handle_back(window),
+                ImeEvent::Key {
+                    key_code,
+                    meta_state,
+                    down,
+                } => {
+                    if let Some(input) = InputState::soft_key(key_code, meta_state, down) {
+                        self.dispatch_input(&window, input);
+                    }
+                }
+            }
+        }
+        true
+    }
+
+    /// Runs main-thread tasks for up to [`MAIN_TASK_BUDGET`]; returns (ran any, more pending).
+    fn run_main_tasks(&self) -> (bool, bool) {
+        let started = Instant::now();
+        let mut ran = false;
+        loop {
+            let runnable = self.main_receiver.borrow_mut().try_pop();
+            match runnable {
+                Ok(Some(runnable)) => {
+                    runnable.run();
+                    ran = true;
+                    if started.elapsed() >= MAIN_TASK_BUDGET {
+                        return (ran, true);
+                    }
+                }
+                Ok(None) | Err(_) => return (ran, false),
+            }
+        }
+    }
+}
+
+jni::bind_java_type! {
+    Activity => "android.app.Activity",
+    methods {
+        fn finish(),
+    }
+}
+
+fn finish_activity() {
+    let app = crate::android_app();
+    // SAFETY: vm_as_ptr is the process JavaVM, valid for the process lifetime.
+    let vm = unsafe { jni::JavaVM::from_raw(app.vm_as_ptr().cast()) };
+    let result = vm.attach_current_thread(|env| -> jni::errors::Result<()> {
+        let raw = app.activity_as_ptr() as jni::sys::jobject;
+        // SAFETY: an unowned global reference that stays valid while `app` is alive; the cast takes no ownership.
+        let activity = unsafe { env.as_cast_raw::<jni::refs::Global<Activity>>(&raw)? };
+        activity.finish(env)
+    });
+    if result.is_err() {
+        log::error!("gpui_android: E_FINISH");
+        // Without a finished Activity there is no Destroy; let the loop end on its own instead.
+        FINISH_FAILED.store(true, std::sync::atomic::Ordering::Release);
+        crate::ime::wake();
+    }
+}
+
+fn ceil_millis(duration: Duration) -> Duration {
+    Duration::from_millis(duration.as_micros().div_ceil(1000) as u64)
+}
+
+impl Platform for AndroidPlatform {
+    fn background_executor(&self) -> BackgroundExecutor {
+        self.background_executor.clone()
+    }
+
+    fn foreground_executor(&self) -> ForegroundExecutor {
+        self.foreground_executor.clone()
+    }
+
+    fn text_system(&self) -> Arc<dyn PlatformTextSystem> {
+        self.text_system.clone()
+    }
+
+    fn run(&self, on_finish_launching: Box<dyn 'static + FnOnce()>) {
+        let mut on_finish_launching = Some(on_finish_launching);
+        let mut last_frame = Instant::now() - FRAME_INTERVAL;
+        let mut more_tasks = false;
+        let mut frame_wanted = true;
+        let mut idle_ticks = 0;
+        let mut force_retries = 0;
+        let mut had_window = false;
+        let mut finishing = false;
+
+        while !self.quitting.get() {
+            if FINISH_FAILED.swap(false, std::sync::atomic::Ordering::Acquire) {
+                break;
+            }
+            // The workspace closed its window (Back, or a close action): there is nothing left to show, so finish the
+            // Activity. gpui also calls quit() when its last window goes; Activity.finish() is idempotent.
+            let has_window = self.window().is_some();
+            if had_window && !has_window && !finishing {
+                finishing = true;
+                self.quit();
+            }
+            had_window |= has_window;
+            let launch_ready =
+                on_finish_launching.is_some() && self.native_window.borrow().is_some();
+            let timeout = if more_tasks || launch_ready {
+                Some(Duration::ZERO)
+            } else if frame_wanted && self.can_draw() {
+                Some(ceil_millis(
+                    FRAME_INTERVAL.saturating_sub(last_frame.elapsed()),
+                ))
+            } else {
+                None
+            };
+
+            let mut woke = false;
+            self.app.poll_events(timeout, |event| match event {
+                PollEvent::Main(event) => {
+                    woke = true;
+                    self.handle_main_event(event);
+                }
+                PollEvent::Wake => woke = true,
+                _ => {}
+            });
+            woke |= self.drain_input();
+            woke |= self.apply_ime();
+            if let Some(window) = self.window() {
+                let press = self.input.borrow_mut().poll_hold(window.modifiers());
+                if let Some(press) = press {
+                    self.dispatch_input(&window, press);
+                    woke = true;
+                }
+            }
+
+            if self.native_window.borrow().is_some()
+                && let Some(launch) = on_finish_launching.take()
+            {
+                launch();
+                woke = true;
+            }
+
+            let (ran, more) = self.run_main_tasks();
+            more_tasks = more;
+            if woke || ran {
+                frame_wanted = true;
+                idle_ticks = 0;
+            }
+            frame_wanted |= self.input.borrow().hold_pending();
+
+            if frame_wanted && self.can_draw() && last_frame.elapsed() >= FRAME_INTERVAL {
+                last_frame = Instant::now();
+                if let Some(window) = self.window() {
+                    let force = self.force_render.replace(false);
+                    window.request_frame(force);
+                    let drew = window.take_drew();
+                    let wants_keyboard = window.has_input_handler() && window.is_active();
+                    if wants_keyboard != self.keyboard_shown.get() {
+                        self.keyboard_shown.set(wants_keyboard);
+                        crate::ime::show_keyboard(wants_keyboard);
+                    }
+                    let retry = (force && !drew) || window.take_needs_force();
+                    force_retries = if retry { force_retries + 1 } else { 0 };
+                    if retry && force_retries <= FORCE_RETRIES {
+                        self.force_render.set(true);
+                    }
+                    if drew || self.force_render.get() {
+                        idle_ticks = 0;
+                    } else {
+                        idle_ticks += 1;
+                    }
+                    frame_wanted = idle_ticks < IDLE_TICKS;
+                }
+            }
+        }
+
+        if let Some(window) = self.window() {
+            window.close();
+        }
+        let quit = self.callbacks.borrow_mut().quit.take();
+        if let Some(mut quit) = quit {
+            quit();
+        }
+        // android_main runs once per Activity but the process outlives it, and GPUI's globals (and
+        // Zed's) can't be initialised twice, so a relaunch must start in a fresh process.
+        std::process::exit(0);
+    }
+
+    fn quit(&self) {
+        // Finish the Activity; the loop then runs until Destroy and exits from there.
+        self.app.run_on_java_main_thread(Box::new(finish_activity));
+    }
+
+    fn restart(&self, _binary_path: Option<PathBuf>) {}
+
+    fn activate(&self, _ignoring_other_apps: bool) {}
+
+    fn hide(&self) {}
+
