+
+    fn unhide_other_apps(&self) {}
+
+    fn displays(&self) -> Vec<Rc<dyn PlatformDisplay>> {
+        self.primary_display().into_iter().collect()
+    }
+
+    fn primary_display(&self) -> Option<Rc<dyn PlatformDisplay>> {
+        let native_window = self.native_window.borrow();
+        let native_window = native_window.as_ref()?;
+        let scale = self.scale_factor();
+        let bounds = gpui::Bounds {
+            origin: gpui::Point::default(),
+            size: gpui::size(
+                gpui::px(native_window.width() as f32 / scale),
+                gpui::px(native_window.height() as f32 / scale),
+            ),
+        };
+        Some(Rc::new(AndroidDisplay::new(bounds, bounds)))
+    }
+
+    fn active_window(&self) -> Option<AnyWindowHandle> {
+        self.active_window.get()
+    }
+
+    fn open_window(
+        &self,
+        handle: AnyWindowHandle,
+        _params: WindowParams,
+    ) -> Result<Box<dyn PlatformWindow>> {
+        if self.window().is_some() {
+            return Err(anyhow!("Android supports a single window"));
+        }
+        let native_window = self
+            .native_window
+            .borrow()
+            .clone()
+            .ok_or_else(|| anyhow!("no native window yet"))?;
+        let new_window = |native_window| {
+            AndroidWindow::new(
+                handle,
+                self.gpu_context.clone(),
+                native_window,
+                self.scale_factor(),
+                self.appearance(),
+            )
+        };
+        let (window, inner) = match new_window(native_window.clone()) {
+            Ok(created) => created,
+            // A forced backend (files/zed/wgpu-backend) without a usable adapter: report it and use the default choice.
+            Err(_) if gpui_wgpu::WgpuContext::backend_override_active() => {
+                log::info!("gpui_android: I_WGPU_NONE");
+                gpui_wgpu::WgpuContext::disable_backend_override();
+                self.gpu_context.borrow_mut().take();
+                new_window(native_window)?
+            }
+            Err(error) => return Err(error),
+        };
+        inner.set_bottom_inset(self.bottom_inset.get());
+        match self
+            .gpu_context
+            .borrow()
+            .as_ref()
+            .map(|context| context.adapter.get_info().backend)
+        {
+            Some(gpui_wgpu::wgpu::Backend::Vulkan) => log::info!("gpui_android: I_WGPU_VULKAN"),
+            Some(gpui_wgpu::wgpu::Backend::Gl) => log::info!("gpui_android: I_WGPU_GL"),
+            Some(_) => log::info!("gpui_android: I_WGPU_OTHER"),
+            None => log::info!("gpui_android: I_WGPU_NONE"),
+        }
+        *self.window.borrow_mut() = Rc::downgrade(&inner);
+        self.active_window.set(Some(handle));
+        self.force_render.set(true);
+        Ok(Box::new(window))
+    }
+
+    fn window_appearance(&self) -> WindowAppearance {
+        self.appearance()
+    }
