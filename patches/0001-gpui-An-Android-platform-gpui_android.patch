+    AnyWindowHandle, Bounds, Capslock, Decorations, DevicePixels, DispatchEventResult, GpuSpecs,
+    Modifiers, Pixels, PlatformAtlas, PlatformDisplay, PlatformInput, PlatformInputHandler,
+    PlatformWindow, Point, PromptButton, PromptLevel, RequestFrameOptions, ResizeEdge, Scene, Size,
+    WindowAppearance, WindowBackgroundAppearance, WindowBounds, WindowControlArea, WindowControls,
+    WindowDecorations, px, size,
+};
+use gpui_wgpu::{GpuContext, WgpuRenderer, WgpuSurfaceConfig};
+use ndk::native_window::NativeWindow;
+use raw_window_handle::{
+    AndroidDisplayHandle, DisplayHandle, HandleError, HasDisplayHandle, HasWindowHandle,
+    RawDisplayHandle, WindowHandle,
+};
+
+use crate::display::AndroidDisplay;
+
+#[derive(Clone, Debug)]
+pub(crate) struct SurfaceHandle(pub(crate) NativeWindow);
+
+impl HasWindowHandle for SurfaceHandle {
+    fn window_handle(&self) -> Result<WindowHandle<'_>, HandleError> {
+        self.0.window_handle()
+    }
+}
+
+impl HasDisplayHandle for SurfaceHandle {
+    fn display_handle(&self) -> Result<DisplayHandle<'_>, HandleError> {
+        Ok(android_display_handle())
+    }
+}
+
+fn android_display_handle() -> DisplayHandle<'static> {
+    // SAFETY: the Android display handle carries no pointers.
+    unsafe { DisplayHandle::borrow_raw(RawDisplayHandle::Android(AndroidDisplayHandle::new())) }
+}
+
+#[derive(Default)]
+struct Callbacks {
+    request_frame: Option<Box<dyn FnMut(RequestFrameOptions)>>,
+    input: Option<Box<dyn FnMut(PlatformInput) -> DispatchEventResult>>,
+    active_status_change: Option<Box<dyn FnMut(bool)>>,
+    hover_status_change: Option<Box<dyn FnMut(bool)>>,
+    resize: Option<Box<dyn FnMut(Size<Pixels>, f32)>>,
+    moved: Option<Box<dyn FnMut()>>,
+    should_close: Option<Box<dyn FnMut() -> bool>>,
+    close: Option<Box<dyn FnOnce()>>,
+    appearance_changed: Option<Box<dyn FnMut()>>,
+    hit_test_window_control: Option<Box<dyn FnMut() -> Option<WindowControlArea>>>,
+}
+
+struct State {
+    renderer: WgpuRenderer,
+    native_window: Option<NativeWindow>,
+    device_size: Size<DevicePixels>,
+    bottom_inset: i32,
+    scale_factor: f32,
+    appearance: WindowAppearance,
+    input_handler: Option<PlatformInputHandler>,
+    is_active: bool,
+    mouse_position: Point<Pixels>,
+    modifiers: Modifiers,
+    capslock: Capslock,
+}
+
+pub(crate) struct WindowInner {
+    gpu_context: GpuContext,
+    state: RefCell<State>,
+    callbacks: RefCell<Callbacks>,
+    drew: Cell<bool>,
+    needs_force: Cell<bool>,
+}
+
+pub(crate) struct AndroidWindow {
+    inner: Rc<WindowInner>,
+    _handle: AnyWindowHandle,
+}
+
+fn device_size_of(native_window: &NativeWindow) -> Size<DevicePixels> {
+    size(
+        DevicePixels(native_window.width().max(1)),
+        DevicePixels(native_window.height().max(1)),
+    )
+}
+
+fn surface_config(device_size: Size<DevicePixels>) -> WgpuSurfaceConfig {
+    WgpuSurfaceConfig {
+        size: device_size,
+        transparent: false,
+        preferred_present_mode: None,
+    }
+}
+
+impl AndroidWindow {
+    pub(crate) fn new(
+        handle: AnyWindowHandle,
+        gpu_context: GpuContext,
+        native_window: NativeWindow,
+        scale_factor: f32,
+        appearance: WindowAppearance,
+    ) -> anyhow::Result<(Self, Rc<WindowInner>)> {
+        let device_size = device_size_of(&native_window);
+        let renderer = WgpuRenderer::new(
+            gpu_context.clone(),
+            &SurfaceHandle(native_window.clone()),
+            surface_config(device_size),
+            None,
+        )?;
+        let inner = Rc::new(WindowInner {
+            gpu_context,
+            state: RefCell::new(State {
+                renderer,
+                native_window: Some(native_window),
+                device_size,
+                bottom_inset: 0,
+                scale_factor,
+                appearance,
+                input_handler: None,
+                is_active: true,
+                mouse_position: Point::default(),
+                modifiers: Modifiers::default(),
+                capslock: Capslock::default(),
+            }),
+            callbacks: RefCell::new(Callbacks::default()),
+            drew: Cell::new(false),
+            needs_force: Cell::new(false),
+        });
+        Ok((
+            Self {
+                inner: inner.clone(),
+                _handle: handle,
+            },
+            inner,
+        ))
+    }
+}
+
+impl WindowInner {
+    /// The part of the surface not covered by the navigation bar or the soft keyboard; GPUI lays out in it and the
+    /// covered strip at the bottom keeps the cleared background.
+    fn logical_size(state: &State) -> Size<Pixels> {
+        let height = (state.device_size.height.0 - state.bottom_inset).max(1);
+        size(
+            px(state.device_size.width.0 as f32 / state.scale_factor),
+            px(height as f32 / state.scale_factor),
+        )
+    }
+
+    pub(crate) fn set_bottom_inset(&self, bottom: i32) {
+        {
+            let mut state = self.state.borrow_mut();
+            if state.bottom_inset == bottom.max(0) {
+                return;
+            }
+            state.bottom_inset = bottom.max(0);
+        }
+        self.notify_resize();
+    }
+
+    pub(crate) fn has_surface(&self) -> bool {
+        self.state.borrow().native_window.is_some()
+    }
+
+    pub(crate) fn attach_surface(&self, native_window: NativeWindow) {
+        let device_size = device_size_of(&native_window);
+        let result = {
+            let context = self.gpu_context.borrow();
+            let Some(context) = context.as_ref() else {
+                log::error!("gpui_android: E_NO_GPU_CONTEXT");
+                return;
+            };
+            let mut state = self.state.borrow_mut();
+            state.device_size = device_size;
+            state.native_window = Some(native_window.clone());
+            state.renderer.replace_surface(
+                &SurfaceHandle(native_window),
+                surface_config(device_size),
+                &context.instance,
+            )
+        };
+        if result.is_err() {
+            log::error!("gpui_android: E_SURFACE");
+            self.state.borrow_mut().native_window = None;
+            return;
+        }
+        self.notify_resize();
+    }
+
+    pub(crate) fn detach_surface(&self) {
+        let mut state = self.state.borrow_mut();
+        state.renderer.release_surface();
+        state.native_window = None;
+    }
+
+    pub(crate) fn update_geometry(&self, scale_factor: f32) {
+        let changed = {
+            let mut state = self.state.borrow_mut();
+            let Some(native_window) = state.native_window.clone() else {
+                state.scale_factor = scale_factor;
+                return;
+            };
+            let device_size = device_size_of(&native_window);
+            let changed = device_size != state.device_size || scale_factor != state.scale_factor;
+            if device_size != state.device_size {
+                state.device_size = device_size;
+                state.renderer.update_drawable_size(device_size);
+            }
+            state.scale_factor = scale_factor;
+            changed
+        };
+        if changed {
+            self.notify_resize();
+        }
+    }
+
+    fn notify_resize(&self) {
+        let (logical_size, scale_factor) = {
+            let state = self.state.borrow();
+            (Self::logical_size(&state), state.scale_factor)
+        };
+        let callback = self.callbacks.borrow_mut().resize.take();
+        if let Some(mut callback) = callback {
+            callback(logical_size, scale_factor);
+            self.callbacks.borrow_mut().resize.get_or_insert(callback);
+        }
+    }
+
+    pub(crate) fn set_appearance(&self, appearance: WindowAppearance) {
+        {
+            let mut state = self.state.borrow_mut();
+            if state.appearance == appearance {
+                return;
+            }
+            state.appearance = appearance;
+        }
+        let callback = self.callbacks.borrow_mut().appearance_changed.take();
+        if let Some(mut callback) = callback {
+            callback();
+            self.callbacks
+                .borrow_mut()
+                .appearance_changed
+                .get_or_insert(callback);
+        }
+    }
+
+    pub(crate) fn set_active(&self, active: bool) {
+        self.state.borrow_mut().is_active = active;
+        let callback = self.callbacks.borrow_mut().active_status_change.take();
+        if let Some(mut callback) = callback {
+            callback(active);
+            self.callbacks
+                .borrow_mut()
+                .active_status_change
+                .get_or_insert(callback);
+        }
+    }
+
+    pub(crate) fn request_frame(&self, force_render: bool) {
+        if !self.has_surface() {
+            return;
+        }
+        let callback = self.callbacks.borrow_mut().request_frame.take();
+        if let Some(mut callback) = callback {
+            callback(RequestFrameOptions {
+                require_presentation: false,
+                force_render,
+            });
+            self.callbacks
+                .borrow_mut()
+                .request_frame
+                .get_or_insert(callback);
+        }
+    }
+
+    pub(crate) fn take_drew(&self) -> bool {
+        self.drew.replace(false)
+    }
+
+    pub(crate) fn take_needs_force(&self) -> bool {
+        self.needs_force.replace(false)
+    }
+
+    pub(crate) fn scale_factor(&self) -> f32 {
+        self.state.borrow().scale_factor
+    }
+
+    pub(crate) fn modifiers(&self) -> Modifiers {
+        self.state.borrow().modifiers
+    }
+
+    pub(crate) fn set_modifiers(&self, modifiers: Modifiers, capslock: Capslock) {
+        let mut state = self.state.borrow_mut();
+        state.modifiers = modifiers;
+        state.capslock = capslock;
+    }
+
+    pub(crate) fn set_mouse_position(&self, position: Point<Pixels>) {
+        self.state.borrow_mut().mouse_position = position;
+    }
+
+    pub(crate) fn handle_input(&self, input: PlatformInput) -> bool {
+        let callback = self.callbacks.borrow_mut().input.take();
+        if let Some(mut callback) = callback {
+            let result = callback(input.clone());
+            self.callbacks.borrow_mut().input.get_or_insert(callback);
+            if !result.propagate {
+                return true;
+            }
+        }
+        if let PlatformInput::KeyDown(event) = input
+            && event.keystroke.modifiers.is_subset_of(&Modifiers::shift())
+            && let Some(key_char) = &event.keystroke.key_char
+        {
+            let handler = self.state.borrow_mut().input_handler.take();
+            if let Some(mut handler) = handler {
+                handler.replace_text_in_range(None, key_char);
+                self.state.borrow_mut().input_handler.get_or_insert(handler);
+                return true;
+            }
+        }
+        false
+    }
+
+    pub(crate) fn is_active(&self) -> bool {
+        self.state.borrow().is_active
+    }
+
+    pub(crate) fn has_input_handler(&self) -> bool {
+        self.state.borrow().input_handler.is_some()
+    }
+
+    pub(crate) fn with_input_handler<R>(
+        &self,
+        f: impl FnOnce(&mut PlatformInputHandler) -> R,
+    ) -> Option<R> {
+        let mut handler = self.state.borrow_mut().input_handler.take()?;
+        let result = f(&mut handler);
+        self.state.borrow_mut().input_handler.get_or_insert(handler);
+        Some(result)
+    }
+
+    pub(crate) fn should_close(&self) -> bool {
+        let callback = self.callbacks.borrow_mut().should_close.take();
+        let Some(mut callback) = callback else {
+            return true;
+        };
+        let result = callback();
+        self.callbacks
+            .borrow_mut()
+            .should_close
+            .get_or_insert(callback);
+        result
+    }
+
+    pub(crate) fn close(&self) {
+        let callback = self.callbacks.borrow_mut().close.take();
+        if let Some(callback) = callback {
+            callback();
+        }
+    }
+}
+
+impl Drop for AndroidWindow {
+    fn drop(&mut self) {
+        self.inner.state.borrow_mut().renderer.destroy();
+    }
+}
+
+impl HasWindowHandle for AndroidWindow {
+    fn window_handle(&self) -> Result<WindowHandle<'_>, HandleError> {
+        let state = self.inner.state.borrow();
+        let native_window = state
+            .native_window
+            .as_ref()
+            .ok_or(HandleError::Unavailable)?;
+        let raw = native_window.window_handle()?.as_raw();
+        // SAFETY: everything here runs on the android_main thread. TerminateWindow is handled inside
+        // poll_events on that thread, never while a caller holds this handle, and it clears
+        // native_window before Android releases the surface.
+        Ok(unsafe { WindowHandle::borrow_raw(raw) })
+    }
+}
+
+impl HasDisplayHandle for AndroidWindow {
+    fn display_handle(&self) -> Result<DisplayHandle<'_>, HandleError> {
+        Ok(android_display_handle())
+    }
+}
+
+impl PlatformWindow for AndroidWindow {
+    fn bounds(&self) -> Bounds<Pixels> {
+        Bounds {
+            origin: Point::default(),
+            size: self.content_size(),
+        }
+    }
+
+    fn is_maximized(&self) -> bool {
+        true
+    }
+
+    fn window_bounds(&self) -> WindowBounds {
+        WindowBounds::Fullscreen(self.bounds())
+    }
+
+    fn content_size(&self) -> Size<Pixels> {
+        WindowInner::logical_size(&self.inner.state.borrow())
+    }
+
+    fn resize(&mut self, _size: Size<Pixels>) {}
+
+    fn scale_factor(&self) -> f32 {
+        self.inner.scale_factor()
+    }
+
+    fn appearance(&self) -> WindowAppearance {
+        self.inner.state.borrow().appearance
+    }
+
+    fn display(&self) -> Option<Rc<dyn PlatformDisplay>> {
+        let bounds = self.bounds();
+        Some(Rc::new(AndroidDisplay::new(bounds, bounds)))
+    }
+
+    fn mouse_position(&self) -> Point<Pixels> {
+        self.inner.state.borrow().mouse_position
+    }
+
+    fn modifiers(&self) -> Modifiers {
+        self.inner.modifiers()
+    }
+
+    fn capslock(&self) -> Capslock {
+        self.inner.state.borrow().capslock
+    }
+
+    fn set_input_handler(&mut self, input_handler: PlatformInputHandler) {
+        self.inner.state.borrow_mut().input_handler = Some(input_handler);
+    }
+
+    fn take_input_handler(&mut self) -> Option<PlatformInputHandler> {
+        self.inner.state.borrow_mut().input_handler.take()
+    }
+
+    fn prompt(
+        &self,
+        _level: PromptLevel,
+        _msg: &str,
+        _detail: Option<&str>,
+        _answers: &[PromptButton],
+    ) -> Option<oneshot::Receiver<usize>> {
+        None
+    }
+
+    fn activate(&self) {}
+
+    fn is_active(&self) -> bool {
+        self.inner.state.borrow().is_active
+    }
+
+    fn is_hovered(&self) -> bool {
+        false
+    }
+
+    fn background_appearance(&self) -> WindowBackgroundAppearance {
+        WindowBackgroundAppearance::Opaque
+    }
+
+    fn set_title(&mut self, _title: &str) {}
+
+    fn set_background_appearance(&self, _background_appearance: WindowBackgroundAppearance) {}
+
+    fn minimize(&self) {}
+
+    fn zoom(&self) {}
+
+    fn toggle_fullscreen(&self) {}
+
+    fn is_fullscreen(&self) -> bool {
+        true
+    }
+
+    fn on_request_frame(&self, callback: Box<dyn FnMut(RequestFrameOptions)>) {
+        self.inner.callbacks.borrow_mut().request_frame = Some(callback);
+    }
+
+    fn on_input(&self, callback: Box<dyn FnMut(PlatformInput) -> DispatchEventResult>) {
+        self.inner.callbacks.borrow_mut().input = Some(callback);
+    }
+
+    fn on_active_status_change(&self, callback: Box<dyn FnMut(bool)>) {
+        self.inner.callbacks.borrow_mut().active_status_change = Some(callback);
+    }
+
+    fn on_hover_status_change(&self, callback: Box<dyn FnMut(bool)>) {
+        self.inner.callbacks.borrow_mut().hover_status_change = Some(callback);
+    }
+
+    fn on_resize(&self, callback: Box<dyn FnMut(Size<Pixels>, f32)>) {
+        self.inner.callbacks.borrow_mut().resize = Some(callback);
+    }
+
+    fn on_moved(&self, callback: Box<dyn FnMut()>) {
+        self.inner.callbacks.borrow_mut().moved = Some(callback);
+    }
+
+    fn on_should_close(&self, callback: Box<dyn FnMut() -> bool>) {
+        self.inner.callbacks.borrow_mut().should_close = Some(callback);
+    }
+
+    fn on_hit_test_window_control(&self, callback: Box<dyn FnMut() -> Option<WindowControlArea>>) {
+        self.inner.callbacks.borrow_mut().hit_test_window_control = Some(callback);
+    }
+
+    fn on_close(&self, callback: Box<dyn FnOnce()>) {
+        self.inner.callbacks.borrow_mut().close = Some(callback);
+    }
+
+    fn on_appearance_changed(&self, callback: Box<dyn FnMut()>) {
+        self.inner.callbacks.borrow_mut().appearance_changed = Some(callback);
+    }
+
+    fn draw(&self, scene: &Scene) {
+        let mut state = self.inner.state.borrow_mut();
+        let Some(native_window) = state.native_window.clone() else {
+            return;
+        };
+        if state.renderer.device_lost() {
+            if state
+                .renderer
+                .recover(&SurfaceHandle(native_window))
+                .is_err()
+            {
+                log::error!("gpui_android: E_GPU_RECOVER");
+            }
+            self.inner.needs_force.set(true);
